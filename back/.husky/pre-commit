# Check staged files for potential secrets before committing
echo "🔍 Checking for secrets in staged files..."

# Get list of staged files (excluding .husky, binary files, and example files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '\.husky/' | grep -v 'package-lock\.json' | grep -v '\.env\.example$')

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No files to check."
  exit 0
fi

# Patterns to detect
PATTERNS=(
  'BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY'
  'sk-[A-Za-z0-9]{20,}'
  'AIza[0-9A-Za-z\-_]{35}'
  'gsk_[A-Za-z0-9]{20,}'
  'APP_USR-[0-9]+-[0-9]+-[a-z0-9]+-[0-9]+'
  'mongodb\+srv://[^:]+:[^@]+@'
  'cloudinary://[0-9]+:[^@]+@'
  'xox[bpras]-[A-Za-z0-9\-_]+'
  'ghp_[A-Za-z0-9]{36}'
  'gho_[A-Za-z0-9]{36}'
  'ghu_[A-Za-z0-9]{36}'
  'ghs_[A-Za-z0-9]{36}'
  'ghr_[A-Za-z0-9]{36}'
  'AKIA[0-9A-Z]{16}'
)

FOUND=0
for FILE in $STAGED_FILES; do
  if [ ! -f "$FILE" ]; then continue; fi
  for PATTERN in "${PATTERNS[@]}"; do
    if grep -qE "$PATTERN" "$FILE" 2>/dev/null; then
      echo "❌ Potential secret found in: $FILE"
      echo "   Pattern matched: $PATTERN"
      FOUND=1
    fi
  done
done

# Check for .env files being committed
for FILE in $STAGED_FILES; do
  if echo "$FILE" | grep -qE '\.env$|\.env\.local$|\.env\.production$'; then
    echo "❌ Environment file staged: $FILE (should be gitignored)"
    FOUND=1
  fi
done

if [ $FOUND -eq 1 ]; then
  echo ""
  echo "⚠️  Secrets detected! Commit blocked."
  echo "   Remove secrets from files or add them to .gitignore."
  echo "   To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi

echo "✅ No secrets detected."
