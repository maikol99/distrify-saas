# ============================================
# BASE DE DATOS (OBLIGATORIO)
# ============================================
MONGO_DB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=distrify

# ============================================
# AUTENTICACIÓN JWT (OBLIGATORIO)
# ============================================
# Generar un secreto largo con: openssl rand -hex 64
JWT_SECRET=tu-super-secreto-muy-largo-y-seguro-minimo-256-bits
JWT_EXPIRES_IN=8h
JWT_ISSUER=distrify
JWT_AUDIENCE=distrify-users
BCRYPT_SALT_ROUNDS=12

# ============================================
# ADMINISTRADOR (OBLIGATORIO)
# ============================================
# MongoDB ObjectId del usuario super-admin. Sin este valor el panel /admin no funciona.
SUPER_ADMIN_ID=

# ============================================
# CLOUDINARY (Gestión de Imágenes)
# ============================================
# Formato completo de CLOUDINARY_URL:
# cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# ============================================
# SERVICIOS DE EMAIL (Resend — obligatorio)
# ============================================
# Crear cuenta gratuita en https://resend.com/
# En desarrollo podés usar: onboarding@resend.dev como EMAIL_FROM (sin verificar dominio)
# En producción debés verificar tu propio dominio en Resend
EMAIL_FROM=noreply@tudominio.com
EMAIL_FROM_NAME=Distrify
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GOOGLE ONE TAP (Login con Google)
# ============================================
# Obtener desde: Google Cloud Console > APIs y Servicios > Credenciales
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# ============================================
# INTELIGENCIA ARTIFICIAL (Elige uno o varios)
# ============================================

# OpenAI (https://platform.openai.com/)
OPEN_AI_API_KEY=sk-

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/)
GROQ_API_KEY=gsk_

# ============================================
# MERCADO PAGO (Pagos Online)
# ============================================
# Obtener desde: https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto para validar firmas HMAC-SHA256 de webhooks (obligatorio en producción)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_QR_ACCESS_TOKEN=

# ============================================
# CIFRADO (OBLIGATORIO)
# ============================================
# Clave AES-256 para cifrar tokens de Mercado Pago en la base de datos
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================
# URLS
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# APLICACIÓN
# ============================================
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://tudominio.com.ar
